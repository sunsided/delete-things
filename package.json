{
	"name": "delete-things",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "tsx scripts/serve.ts build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest --run",
		"test:unit": "vitest",
		"test:component": "vitest --run --project component",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"browsers": "playwright install chromium",
		"storybook": "storybook dev -p 6026 --no-open --ci",
		"storybook:build": "storybook build"
	},
	"packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@fontsource/instrument-sans": "^5.3.0",
		"@playwright/test": "^1.64.1",
		"@storybook/addon-a11y": "^10.6.2",
		"@storybook/addon-docs": "^10.6.2",
		"@storybook/addon-svelte-csf": "^5.1.5",
		"@storybook/svelte": "^10.6.2",
		"@storybook/sveltekit": "^10.6.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.5",
		"@vitest/browser": "^5.0.5",
		"@vitest/browser-playwright": "^5.0.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"storybook": "^10.6.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
